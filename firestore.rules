rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared validation primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBloque(b) {
      return b is string && b in ['Conocimientos', 'Actitudes'];
    }

    function isValidTema(t) {
      return t is string && t in ['Movilidad Segura', 'Normas', 'Señales', 'Vehículo', 'Actitudes'];
    }

    function isValidTipo(tp) {
      return tp is string && tp in ['multiple', 'binary'];
    }

    function isValidQuestion(data) {
      return data.keys().hasAll([
          'id', 'bloque', 'tema', 'tipo', 'enunciado',
          'opciones', 'respuestaCorrecta', 'explicacion', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'bloque', 'tema', 'tipo', 'caso', 'enunciado',
          'opciones', 'respuestaCorrecta', 'explicacion', 'moduloAulapp', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidBloque(data.bloque)
        && isValidTema(data.tema)
        && isValidTipo(data.tipo)
        && (!('caso' in data) || (data.caso is string && data.caso.size() <= 4000))
        && data.enunciado is string && data.enunciado.size() >= 1 && data.enunciado.size() <= 6000
        && data.opciones is list && data.opciones.size() >= 2 && data.opciones.size() <= 6
        && data.opciones[0] is map
        && data.respuestaCorrecta is string && data.respuestaCorrecta.size() >= 1 && data.respuestaCorrecta.size() <= 100
        && data.explicacion is string && data.explicacion.size() <= 4000
        && (!('moduloAulapp' in data) || (data.moduloAulapp is string && data.moduloAulapp.size() <= 500))
        && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64;
    }

    function isValidAccessKey(data) {
      return data.keys().hasAll([
          'id', 'code', 'studentName', 'daysValid', 'createdAt', 'expiresAt', 'active'
        ])
        && data.keys().hasOnly([
          'id', 'code', 'studentName', 'daysValid', 'createdAt', 'expiresAt', 'active'
        ])
        && isValidId(data.id)
        && data.code is string && data.code.size() >= 3 && data.code.size() <= 40 && data.code.matches('^[A-Z0-9_\\-]+$')
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.daysValid is number && data.daysValid >= 1 && data.daysValid <= 3650
        && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
        && data.expiresAt is string && data.expiresAt.size() >= 10 && data.expiresAt.size() <= 64
        && data.active is bool;
    }

    function isValidExamResult(data) {
      return data.keys().hasAll([
          'id', 'accessCode', 'studentName', 'createdAt', 'durationSeconds',
          'totalQuestions', 'conocimientosTotal', 'conocimientosCorrect', 'conocimientosPct',
          'actitudesTotal', 'actitudesCorrect', 'actitudesPct', 'passed',
          'themeBreakdown', 'answers'
        ])
        && data.keys().hasOnly([
          'id', 'accessKeyId', 'accessCode', 'studentName', 'createdAt', 'durationSeconds',
          'totalQuestions', 'conocimientosTotal', 'conocimientosCorrect', 'conocimientosPct',
          'actitudesTotal', 'actitudesCorrect', 'actitudesPct', 'passed',
          'themeBreakdown', 'answers'
        ])
        && isValidId(data.id)
        && (!('accessKeyId' in data) || isValidId(data.accessKeyId))
        && data.accessCode is string && data.accessCode.size() >= 3 && data.accessCode.size() <= 40
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && data.totalQuestions is number && data.totalQuestions >= 1 && data.totalQuestions <= 200
        && data.conocimientosTotal is number && data.conocimientosTotal >= 0 && data.conocimientosTotal <= 200
        && data.conocimientosCorrect is number && data.conocimientosCorrect >= 0 && data.conocimientosCorrect <= 200
        && data.conocimientosPct is number && data.conocimientosPct >= 0 && data.conocimientosPct <= 100
        && data.actitudesTotal is number && data.actitudesTotal >= 0 && data.actitudesTotal <= 200
        && data.actitudesCorrect is number && data.actitudesCorrect >= 0 && data.actitudesCorrect <= 200
        && data.actitudesPct is number && data.actitudesPct >= 0 && data.actitudesPct <= 100
        && data.passed is bool
        && data.themeBreakdown is list && data.themeBreakdown.size() <= 10
        && data.answers is list && data.answers.size() >= 1 && data.answers.size() <= 200
        && data.answers[0] is map;
    }

    function isValidMistake(data) {
      return data.keys().hasAll([
          'id', 'accessCode', 'questionId', 'bloque', 'tema', 'tipo',
          'enunciado', 'opciones', 'wrongKey', 'correctKey', 'explicacion',
          'failedCount', 'lastFailedAt', 'resolved'
        ])
        && data.keys().hasOnly([
          'id', 'accessKeyId', 'accessCode', 'questionId', 'bloque', 'tema', 'tipo',
          'caso', 'enunciado', 'opciones', 'wrongKey', 'correctKey', 'explicacion',
          'failedCount', 'lastFailedAt', 'resolved'
        ])
        && isValidId(data.id)
        && (!('accessKeyId' in data) || isValidId(data.accessKeyId))
        && data.accessCode is string && data.accessCode.size() >= 3 && data.accessCode.size() <= 40
        && isValidId(data.questionId)
        && isValidBloque(data.bloque)
        && isValidTema(data.tema)
        && isValidTipo(data.tipo)
        && (!('caso' in data) || (data.caso is string && data.caso.size() <= 4000))
        && data.enunciado is string && data.enunciado.size() >= 1 && data.enunciado.size() <= 6000
        && data.opciones is list && data.opciones.size() >= 2 && data.opciones.size() <= 6
        && data.opciones[0] is map
        && data.wrongKey is string && data.wrongKey.size() >= 1 && data.wrongKey.size() <= 100
        && data.correctKey is string && data.correctKey.size() >= 1 && data.correctKey.size() <= 100
        && data.explicacion is string && data.explicacion.size() <= 4000
        && data.failedCount is number && data.failedCount >= 1 && data.failedCount <= 1000
        && data.lastFailedAt is string && data.lastFailedAt.size() >= 10 && data.lastFailedAt.size() <= 64
        && data.resolved is bool;
    }

    // Connection check document used by startup testConnection()
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // System bootstrap marker
    match /system/{docId} {
      allow get: if docId == 'bootstrap';
      allow create, update: if docId == 'bootstrap'
        && incoming().keys().hasAll(['initialized', 'migratedAt'])
        && incoming().keys().hasOnly(['initialized', 'migratedAt'])
        && incoming().initialized is bool
        && incoming().migratedAt is string && incoming().migratedAt.size() <= 64;
      allow list, delete: if false;
    }

    // Question bank collection
    match /questions/{questionId} {
      allow get: if isValidId(questionId);
      allow list: if true;
      allow create: if isValidId(questionId)
        && isValidQuestion(incoming())
        && incoming().id == questionId;
      allow update: if isValidId(questionId)
        && isValidQuestion(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'bloque', 'tema', 'tipo', 'caso', 'enunciado',
          'opciones', 'respuestaCorrecta', 'explicacion', 'moduloAulapp'
        ]);
      allow delete: if isValidId(questionId);
    }

    // Student access keys collection
    match /accessKeys/{keyId} {
      allow get: if isValidId(keyId);
      allow list: if true;
      allow create: if isValidId(keyId)
        && isValidAccessKey(incoming())
        && incoming().id == keyId;
      allow update: if isValidId(keyId)
        && isValidAccessKey(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'code', 'studentName', 'daysValid', 'expiresAt', 'active'
        ]);
      allow delete: if isValidId(keyId);
    }

    // Exam results collection
    match /examResults/{attemptId} {
      allow get: if isValidId(attemptId);
      allow list: if true;
      allow create: if isValidId(attemptId)
        && isValidExamResult(incoming())
        && incoming().id == attemptId;
      allow update, delete: if false;
    }

    // Failed questions collection for Repasar Errores
    match /mistakes/{mistakeId} {
      allow get: if isValidId(mistakeId);
      allow list: if true;
      allow create: if isValidId(mistakeId)
        && isValidMistake(incoming())
        && incoming().id == mistakeId;
      allow update: if isValidId(mistakeId)
        && isValidMistake(incoming())
        && incoming().id == existing().id
        && incoming().questionId == existing().questionId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'accessCode', 'wrongKey', 'correctKey', 'explicacion',
          'failedCount', 'lastFailedAt', 'resolved'
        ]);
      allow delete: if isValidId(mistakeId);
    }
  }
}
